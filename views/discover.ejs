<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudyScout | វេទិការៀនសូត្រ</title>
    
    <!-- Clean, non-squished Modern Khmer Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@400;500;600;700&family=Koh+Santepheap:wght@400;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #f8fafc;
            --card-bg: #ffffff;
            --border: #e2e8f0;
            --border-hover: #cbd5e1;
            
            --primary: #4338ca;
            --primary-hover: #3730a3;
            --primary-light: #eef2ff;
            
            --text-main: #0f172a;
            --text-sub: #475569;
            --text-muted: #94a3b8;
            
            --radius-lg: 16px;
            --radius-md: 10px;
            --radius-sm: 6px;
            
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 12px -2px rgba(0, 0, 0, 0.08);
            
            /* Clean web font stack */
            --font-family: 'Battambang', sans-serif;
        }

        * { 
            box-sizing: border-box; 
            margin: 0; 
            padding: 0; 
        }

        body {
            font-family: var(--font-family);
            background-color: var(--bg);
            color: var(--text-main);
            /* Increased line-height specifically for Khmer subscript characters */
            line-height: 1.8;
            letter-spacing: 0.2px;
            -webkit-font-smoothing: antialiased;
            padding-bottom: 80px;
        }

        button, input, select, textarea {
            font-family: var(--font-family);
        }

        .icon {
            width: 18px;
            height: 18px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
            display: inline-block;
            vertical-align: middle;
            flex-shrink: 0;
        }

        /* --- Header --- */
        .app-header {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 90;
            padding: 14px 24px;
        }

        .header-container {
            max-width: 1320px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--primary);
            text-decoration: none;
        }

        .brand-badge {
            background: var(--primary-light);
            color: var(--primary);
            font-size: 0.75rem;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: var(--radius-sm);
        }

        .search-box {
            flex: 1;
            max-width: 480px;
            position: relative;
        }

        .search-box input {
            width: 100%;
            height: 44px;
            padding: 0 16px 0 42px;
            border-radius: 99px;
            border: 1px solid var(--border);
            background: #f1f5f9;
            font-family: var(--font-family);
            font-size: 0.9rem;
            outline: none;
            transition: all 0.2s ease;
        }

        .search-box input:focus {
            background: #ffffff;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(67, 56, 202, 0.12);
        }

        .search-box .search-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            pointer-events: none;
        }

        .btn-google {
            background: #ffffff;
            color: var(--text-main);
            border: 1px solid var(--border);
            height: 42px;
            padding: 0 18px;
            border-radius: 99px;
            font-family: var(--font-family);
            font-weight: 600;
            font-size: 0.88rem;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: var(--shadow-sm);
        }

        /* --- Container --- */
        .app-container {
            max-width: 1320px;
            margin: 28px auto 0 auto;
            padding: 0 24px;
        }

        /* --- Filter Panel --- */
        .filter-panel {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 20px;
            margin-bottom: 28px;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .filter-row {
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        .filter-label {
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--text-muted);
            min-width: 80px;
            padding-top: 6px;
        }

        .pill-container {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            flex: 1;
        }

        .pill {
            background: #f1f5f9;
            border: 1px solid transparent;
            color: var(--text-sub);
            padding: 6px 16px;
            border-radius: 99px;
            font-size: 0.88rem;
            font-weight: 500;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.2s ease;
            user-select: none;
        }

        .pill:hover { background: #e2e8f0; color: var(--text-main); }
        .pill.active { background: var(--primary); color: #ffffff; font-weight: 600; }

        .pill-container.collapsed .pill.extra-category {
            display: none !important;
        }

        .btn-toggle-categories {
            background: none;
            border: none;
            color: var(--primary);
            font-family: var(--font-family);
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            padding: 6px 10px;
            border-radius: 99px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        /* --- View Switcher Tabs --- */
        .tab-section {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 2px solid var(--border);
            margin-bottom: 24px;
        }

        .tab-group { display: flex; gap: 24px; }

        .tab-btn {
            background: none;
            border: none;
            padding: 12px 4px;
            font-family: var(--font-family);
            font-size: 0.98rem;
            font-weight: 600;
            color: var(--text-sub);
            cursor: pointer;
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .tab-btn.active { color: var(--primary); font-weight: 700; }
        .tab-btn.active::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--primary);
            border-radius: 2px;
        }

        .results-count { font-size: 0.88rem; color: var(--text-muted); font-weight: 500; }

        /* --- Layout Grid --- */
        .content-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
            gap: 24px;
            align-items: start;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            box-shadow: var(--shadow-sm);
        }

        .card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
        }

        /* Author Profile Header */
        .author-header {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-bottom: 1px solid #f1f5f9;
        }

        .author-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            object-fit: cover;
            border: 1.5px solid var(--border);
            background: var(--primary-light);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: var(--primary);
            font-size: 0.95rem;
            flex-shrink: 0;
        }

        .author-info {
            display: flex;
            flex-direction: column;
            line-height: 1.3;
        }

        .author-name {
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .author-time {
            font-size: 0.76rem;
            color: var(--text-muted);
        }

        /* Dynamic Video Frame */
        .media-frame {
            position: relative;
            width: 100%;
            background: #000000;
            display: flex;
            align-items: center;
            justify-content: center;
            max-height: 480px;
        }

        .media-frame video {
            width: 100%;
            max-height: 480px;
            object-fit: contain;
        }

        .card-body {
            padding: 16px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .badge-group {
            display: flex;
            gap: 6px;
            margin-bottom: 10px;
        }

        .badge {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: var(--radius-sm);
            line-height: 1.5;
        }

        .badge-subject { background: var(--primary-light); color: var(--primary); }
        .badge-grade { background: #f1f5f9; color: var(--text-sub); }

        .card-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 6px;
            line-height: 1.5;
        }

        .card-desc {
            font-size: 0.88rem;
            color: var(--text-sub);
            margin-bottom: 16px;
            flex-grow: 1;
            line-height: 1.6;
        }

        .card-footer {
            margin-top: auto;
            display: flex;
            gap: 8px;
        }

        .btn-action {
            flex: 1;
            height: 40px;
            border-radius: var(--radius-md);
            font-family: var(--font-family);
            font-size: 0.88rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            text-decoration: none;
            cursor: pointer;
            border: 1px solid var(--border);
            background: #ffffff;
            color: var(--text-main);
        }

        .btn-action.primary {
            background: var(--primary);
            color: #ffffff;
            border: none;
        }

        /* Engagement Bar */
        .social-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 0 0 0;
            border-top: 1px solid var(--border);
            margin-top: 12px;
        }

        .social-btn {
            background: none;
            border: none;
            color: var(--text-sub);
            font-family: var(--font-family);
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 4px 6px;
            border-radius: 6px;
        }

        .social-btn.liked { color: #e11d48; }
        .social-btn.liked .icon { fill: #e11d48; stroke: #e11d48; }
        .social-btn.saved { color: var(--primary); }
        .social-btn.saved .icon { fill: var(--primary); stroke: var(--primary); }

        .comment-section {
            display: none;
            border-top: 1px solid var(--border);
            padding-top: 12px;
            margin-top: 8px;
        }

        .comment-section.active { display: block; }

        .comment-list {
            max-height: 140px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 10px;
        }

        .comment-item {
            background: #f8fafc;
            padding: 8px 12px;
            border-radius: var(--radius-sm);
            font-size: 0.82rem;
            line-height: 1.5;
        }

        .comment-author { font-weight: 700; margin-bottom: 2px; }

        .comment-input-group { display: flex; gap: 6px; }

        .comment-input-group input {
            flex: 1;
            height: 36px;
            padding: 0 12px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-family: var(--font-family);
            font-size: 0.82rem;
            outline: none;
        }

        .comment-input-group button {
            background: var(--primary);
            color: #ffffff;
            border: none;
            padding: 0 14px;
            border-radius: var(--radius-sm);
            font-family: var(--font-family);
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
        }

        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            padding: 60px 20px;
            background: var(--card-bg);
            border: 1px dashed var(--border);
            border-radius: var(--radius-lg);
        }
    </style>
</head>

<body>

    <header class="app-header">
        <div class="header-container">
            <a href="#" class="brand-logo">
                <svg class="icon" style="width:24px; height:24px; stroke:var(--primary);" viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                <span>StudyScout</span>
                <span class="brand-badge">ថ្នាក់ខ្ពស់</span>
            </a>

            <div class="search-box">
                <svg class="icon search-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="text" id="searchInput" placeholder="ស្វែងរកមេរៀន សៀវភៅ ឬកូដ..." oninput="handleFilter()">
            </div>

            <button class="btn-google" onclick="openGoogleSearch()">
                <svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                <span>ស្វែងរក Google</span>
            </button>
        </div>
    </header>

    <main class="app-container">

        <section class="filter-panel">
            <div class="filter-row">
                <span class="filter-label">ថ្នាក់ទី</span>
                <div class="pill-container">
                    <span class="pill active" onclick="setGradeFilter('ALL', this)">ទាំងអស់</span>
                    <span class="pill" onclick="setGradeFilter('GRADE_7', this)">ថ្នាក់ទី ៧</span>
                    <span class="pill" onclick="setGradeFilter('GRADE_8', this)">ថ្នាក់ទី ៨</span>
                    <span class="pill" onclick="setGradeFilter('GRADE_9', this)">ថ្នាក់ទី ៩</span>
                    <span class="pill" onclick="setGradeFilter('GRADE_10', this)">ថ្នាក់ទី ១០</span>
                    <span class="pill" onclick="setGradeFilter('GRADE_11', this)">ថ្នាក់ទី ១១</span>
                    <span class="pill" onclick="setGradeFilter('GRADE_12', this)">ថ្នាក់ទី ១២</span>
                    <span class="pill" onclick="setGradeFilter('UNIVERSITY', this)">មហាវិទ្យាល័យ</span>
                </div>
            </div>

            <div class="filter-row">
                <span class="filter-label">មុខវិជ្ជា</span>
                
                <div class="pill-container collapsed" id="subjectContainer">
                    <span class="pill active" onclick="setSubjectFilter('ALL', this)">ទាំងអស់</span>
                    <span class="pill" onclick="setSubjectFilter('CODING', this)">កូដ / បច្ចេកវិទ្យា</span>
                    <span class="pill" onclick="setSubjectFilter('MATH', this)">គណិតវិទ្យា</span>
                    <span class="pill" onclick="setSubjectFilter('BIOLOGY', this)">ជីវវិទ្យា</span>
                    <span class="pill" onclick="setSubjectFilter('PHYSICS', this)">រូបវិទ្យា</span>
                    
                    <span class="pill extra-category" onclick="setSubjectFilter('CHEMISTRY', this)">គីមីវិទ្យា</span>
                    <span class="pill extra-category" onclick="setSubjectFilter('GEOGRAPHY', this)">ភូមិវិទ្យា</span>
                    <span class="pill extra-category" onclick="setSubjectFilter('HISTORY', this)">ប្រវត្តិវិទ្យា</span>
                    <span class="pill extra-category" onclick="setSubjectFilter('KHMER', this)">អក្សរសាស្ត្រខ្មែរ</span>

                    <% 
                        if (typeof dipslayKnowledg !== 'undefined' && dipslayKnowledg.length > 0) {
                            const defaultSubjects = ['CODING', 'MATH', 'BIOLOGY', 'PHYSICS', 'CHEMISTRY', 'GEOGRAPHY', 'HISTORY', 'KHMER'];
                            const extraSubjects = [...new Set(dipslayKnowledg.map(i => i.type_subject).filter(Boolean))]
                                .filter(s => !defaultSubjects.includes(String(s).toUpperCase()));
                                
                            extraSubjects.forEach(s => { 
                    %>
                        <span class="pill extra-category" onclick="setSubjectFilter('<%= s %>', this)"><%= s %></span>
                    <% 
                            });
                        } 
                    %>
                </div>

                <button class="btn-toggle-categories" id="toggleSubjectBtn" onclick="toggleCategories()">
                    <span id="toggleText">បង្ហាញបន្ថែម</span>
                    <svg class="icon" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                </button>
            </div>
        </section>

        <!-- Tabs -->
        <section class="tab-section">
            <div class="tab-group">
                <button class="tab-btn active" id="tabVideo" onclick="switchMediaType('VIDEO')">
                    <svg class="icon" viewBox="0 0 24 24"><polygon points="23 7 16 12 23 17 23 7"/><rect width="15" height="14" x="1" y="5" rx="2" ry="2"/></svg>
                    <span>មេរៀនវីដេអូ</span>
                </button>
                <button class="tab-btn" id="tabPDF" onclick="switchMediaType('PDF')">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
                    <span>សៀវភៅ &amp; PDF</span>
                </button>
            </div>

            <span class="results-count" id="resultsCount">បង្ហាញលទ្ធផល</span>
        </section>

        <!-- Content Grid -->
        <section class="content-grid" id="contentGrid">
            <% if (typeof knowledgeProfile !== 'undefined' && knowledgeProfile.length > 0) { %>
                <% knowledgeProfile.forEach((item, index) => { 
                    const isVideo = !!(item.video_url || item.resource_type === 'VIDEO');
                    const isPdf = !!(item.pdf_url || item.resource_type === 'PDF');
                    const cardId = item.id || index;
                    const authorName = item.username || 'អ្នកចែករំលែក';
                    const authorAvatar = item.emoji_char || '';
                    const views = item.views || Math.floor(Math.random() * 250) + 12;
                %>
                    <article class="card resource-card" 
                         data-type="<%= isVideo ? 'VIDEO' : 'PDF' %>"
                         data-grade="<%= item.grade %>" 
                         data-subject="<%= item.type_subject %>" 
                         data-title="<%= item.title %>">
                        
                        <!-- Author Header -->
                        <div class="author-header">
                            <% if (authorAvatar) { %>
                            <div class="author-avatar" style="font-size: 1.2rem;"><%= authorAvatar %></div>                            <% } else { %>
                                <div class="author-avatar"><%= authorName.charAt(0).toUpperCase() %></div>
                            <% } %>
                            <div class="author-info">
                                <span class="author-name"><%= authorName %></span>
                                <span class="author-time">បានបង្ហោះមេរៀន</span>
                            </div>
                        </div>

                        <% if (isVideo) { %>
                            <div class="media-frame">
                                <video controls preload="metadata">
                                    <source src="<%= item.video_url %>" type="video/mp4">
                                </video>
                            </div>
                        <% } %>

                        <div class="card-body">
                            <div class="badge-group">
                                <span class="badge badge-subject" data-raw-subject="<%= item.type_subject %>"><%= item.type_subject %></span>
                                <span class="badge badge-grade" data-raw-grade="<%= item.grade %>"><%= item.grade %></span>
                            </div>

                            <h3 class="card-title"><%= item.title %></h3>
                            <p class="card-desc"><%= item.description %></p>

                            <div class="card-footer">
                                <% if (isVideo) { %>
                                    <a href="<%= item.video_url %>" target="_blank" class="btn-action primary">
                                        <svg class="icon" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                        <span>មើលពេញអេក្រង់</span>
                                    </a>
                                <% } else if (isPdf) { %>
                                    <a href="<%= item.pdf_url %>" target="_blank" class="btn-action">
                                        <svg class="icon" viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                                        <span>អាន</span>
                                    </a>
                                    <a href="<%= item.pdf_url %>" download class="btn-action primary">
                                        <svg class="icon" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                        <span>ទាញយក PDF</span>
                                    </a>
                                <% } %>
                            </div>

                            <div class="social-bar">
                                <span class="social-btn" style="cursor:default;" title="ចំនួនទស្សនា">
                                    <svg class="icon" viewBox="0 0 24 24"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                    <span><%= views %></span>
                                </span>

                                <button class="social-btn" id="likeBtn-<%= cardId %>" onclick="toggleLike('<%= cardId %>')">
                                    <svg class="icon" viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                                    <span id="likeCount-<%= cardId %>"><%= item.likes || 0 %></span>
                                </button>
                                
                                <button class="social-btn" id="saveBtn-<%= cardId %>" onclick="toggleSave('<%= cardId %>')">
                                    <svg class="icon" viewBox="0 0 24 24"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
                                    <span id="saveLabel-<%= cardId %>">រក្សាទុក</span>
                                </button>

                                <button class="social-btn" onclick="toggleCommentSection('<%= cardId %>')">
                                    <svg class="icon" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                                    <span id="commentCount-<%= cardId %>">0</span>
                                </button>
                            </div>

                            <div class="comment-section" id="commentSection-<%= cardId %>">
                                <div class="comment-list" id="commentList-<%= cardId %>">
                                    <div class="comment-item">
                                        <div class="comment-author">លោកគ្រូ / អ្នកសម្រួល</div>
                                        <div>សួរស្រាវជ្រាវ ឬចោទសួរអំពីមេរៀននេះនៅទីនេះបាន!</div>
                                    </div>
                                </div>
                                <div class="comment-input-group">
                                    <input type="text" id="commentInput-<%= cardId %>" placeholder="សួរសំណួររបស់អ្នក...">
                                    <button onclick="addComment('<%= cardId %>')">ផ្ញើ</button>
                                </div>
                            </div>
                        </div>
                    </article>
                <% }); %>
            <% } %>

            <div class="empty-state" id="emptyState" style="display: none;">
                <svg class="icon" style="width:48px; height:48px; color:var(--text-muted); margin-bottom:12px;" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <div class="empty-text">មិនមានទិន្នន័យដែលត្រូវគ្នានឹងការស្វែងរករបស់អ្នកទេ</div>
            </div>
        </section>

    </main>

    <script>
        const khmerMap = {
            'CODING': 'កូដ / IT',
            'MATH': 'គណិតវិទ្យា',
            'BIOLOGY': 'ជីវវិទ្យា',
            'PHYSICS': 'រូបវិទ្យា',
            'CHEMISTRY': 'គីមីវិទ្យា',
            'GEOGRAPHY': 'ភូមិវិទ្យា',
            'HISTORY': 'ប្រវត្តិវិទ្យា',
            'KHMER': 'អក្សរសាស្ត្រខ្មែរ',
            'GRADE_7': 'ថ្នាក់ទី ៧',
            'GRADE_8': 'ថ្នាក់ទី ៨',
            'GRADE_9': 'ថ្នាក់ទី ៩',
            'GRADE_10': 'ថ្នាក់ទី ១០',
            'GRADE_11': 'ថ្នាក់ទី ១១',
            'GRADE_12': 'ថ្នាក់ទី ១២',
            'UNIVERSITY': 'មហាវិទ្យាល័យ'
        };

        let currentMediaType = 'VIDEO';
        let currentGrade = 'ALL';
        let currentSubject = 'ALL';

        function translateBadges() {
            document.querySelectorAll('.badge-subject').forEach(el => {
                const raw = el.getAttribute('data-raw-subject');
                if (raw && khmerMap[raw.toUpperCase()]) el.innerText = khmerMap[raw.toUpperCase()];
            });

            document.querySelectorAll('.badge-grade').forEach(el => {
                const raw = el.getAttribute('data-raw-grade');
                if (raw && khmerMap[raw.toUpperCase()]) el.innerText = khmerMap[raw.toUpperCase()];
            });
        }

        function toggleCategories() {
            const container = document.getElementById('subjectContainer');
            const label = document.getElementById('toggleText');
            const isCollapsed = container.classList.toggle('collapsed');
            label.innerText = isCollapsed ? 'បង្ហាញបន្ថែម' : 'បង្រួមវិញ';
        }

        function switchMediaType(type) {
            currentMediaType = type;
            document.getElementById('tabVideo').classList.toggle('active', type === 'VIDEO');
            document.getElementById('tabPDF').classList.toggle('active', type === 'PDF');
            handleFilter();
        }

        function setGradeFilter(grade, el) {
            currentGrade = String(grade).toUpperCase();
            el.parentElement.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
            el.classList.add('active');
            handleFilter();
        }

        function setSubjectFilter(subject, el) {
            currentSubject = String(subject).toUpperCase();
            el.parentElement.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
            el.classList.add('active');
            handleFilter();
        }

        function handleFilter() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            const cards = document.querySelectorAll('.resource-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const cardType = String(card.getAttribute('data-type')).toUpperCase();
                const grade = String(card.getAttribute('data-grade')).toUpperCase();
                const subject = String(card.getAttribute('data-subject')).toUpperCase();
                const title = card.getAttribute('data-title').toLowerCase();

                const matchType = (cardType === currentMediaType);
                const matchGrade = (currentGrade === 'ALL') || grade.includes(currentGrade) || currentGrade.includes(grade);
                const matchSubject = (currentSubject === 'ALL') || (subject === currentSubject);
                const matchQuery = !query || title.includes(query);

                if (matchType && matchGrade && matchSubject && matchQuery) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            const emptyState = document.getElementById('emptyState');
            const countLabel = document.getElementById('resultsCount');

            countLabel.innerText = `${visibleCount} មេរៀនត្រូវរកឃើញ`;
            emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }

        function toggleLike(id) {
            const btn = document.getElementById(`likeBtn-${id}`);
            const countEl = document.getElementById(`likeCount-${id}`);
            let count = parseInt(countEl.innerText) || 0;

            if (btn.classList.contains('liked')) {
                btn.classList.remove('liked');
                countEl.innerText = count - 1;
            } else {
                btn.classList.add('liked');
                countEl.innerText = count + 1;
            }
        }

        function toggleSave(id) {
            const btn = document.getElementById(`saveBtn-${id}`);
            const label = document.getElementById(`saveLabel-${id}`);

            if (btn.classList.contains('saved')) {
                btn.classList.remove('saved');
                label.innerText = 'រក្សាទុក';
            } else {
                btn.classList.add('saved');
                label.innerText = 'បានរក្សាទុក';
            }
        }

        function toggleCommentSection(id) {
            const section = document.getElementById(`commentSection-${id}`);
            section.classList.toggle('active');
        }

        function addComment(id) {
            const input = document.getElementById(`commentInput-${id}`);
            const text = input.value.trim();
            if (!text) return;

            const list = document.getElementById(`commentList-${id}`);
            const newComment = document.createElement('div');
            newComment.className = 'comment-item';
            newComment.innerHTML = `<div class="comment-author">អ្នកសិក្សា</div><div>${text}</div>`;
            list.appendChild(newComment);

            const countEl = document.getElementById(`commentCount-${id}`);
            countEl.innerText = parseInt(countEl.innerText) + 1;

            input.value = '';
            list.scrollTop = list.scrollHeight;
        }

        function openGoogleSearch() {
            const query = document.getElementById('searchInput').value.trim();
            window.open('https://www.google.com/search?q=' + encodeURIComponent(query || 'Cambodia study lessons'), '_blank');
        }

        document.addEventListener('DOMContentLoaded', () => {
            translateBadges();
            handleFilter();
        });
    </script>
</body>
</html>