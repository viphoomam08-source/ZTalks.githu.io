        <!-- 🔍 VIEW 2: TRAILER DISCOVERY INTERFACE -->
        <div id="find-view" class="view-panel">
            <%- include('discover') %>
        </div>

        <!-- 💬 VIEW 3: MESSENGER BOX -->
        <div id="chat-view" class="view-panel" style="background: #f1f5f9;">
            <%- include('video') %>
        </div>

        <!-- 🎥 VIEW 4: LIVE CALL ROOM -->
        <div id="live-view" class="view-panel">
            <div class="live-room-container">
                <div class="video-grid-mock">
                    <div class="video-feed-box">
                        <span>[ Local Video ]</span>
                        <div class="feed-label">Your Camera</div>
                    </div>
                    <div class="video-feed-box">
                        <span>[ Peer Video ]</span>
                        <div class="feed-label">Connected Friend</div>
                    </div>
                </div>
                <div class="call-controls">
                    <button class="end-call-btn" onclick="alert('Disconnecting session...')">
