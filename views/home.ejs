        <svg class="action-icon" viewBox="0 0 24 24">
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </svg>
        <span>Share</span>
    </button>

    <!-- Save Button -->
    <button class="action-trigger-btn save-btn" onclick="toggleSave(this)">
        <svg class="action-icon" viewBox="0 0 24 24">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
        </svg>
        <span class="save-label">Save</span>
    </button>
</div>
                    
                <div id="comments-post-<%= post[i].id %>" class="comments-section-wrapper">
                    <div class="comments-list">
                        <div class="single-comment"><strong>@sarah_travels</strong> Super clean layout!</div>
                    </div>
                    <div class="comment-input-inline">
                        <input type="text" placeholder="Write a comment..." onkeypress="handleCommentSubmit(event, 'comments-post-<%= post[i].id %>', this)">
                        <button class="comment-submit-btn" onclick="addCommentDirectly('comments-post-<%= post[i].id %>')">Post</button>
