        <!-- 📜 VIEW 5: POLICY -->
        <div id="policy-view" class="view-panel">
            <%- include('policy') %>
        </div>

    </div>

    <!-- 🔘 Floating Circle Action Button -->
    <button class="fab-btn" onclick="openCreatePostModal()" aria-label="Create Post">+</button>

    <!-- 📝 Create Post Modal -->
    <div id="createPostModal" class="modal-overlay" onclick="handleModalOverlayClick(event)">
        <div class="modal-card">
            <div class="modal-header">
                <span class="modal-title">Create Post</span>
                <button class="modal-close-icon" onclick="closeCreatePostModal()">&times;</button>
            </div>
            <div class="modal-body">
                <div class="user-profile-row">
                    <div class="avatar-circle">
                        <%= user.username ? user.username.charAt(0).toUpperCase() : 'D' %>
                    </div>
                    <div class="user-details">
                        <span class="user-name"><%= user.username || 'daro' %></span>
                        <div class="privacy-badge">
                            <span>👥</span> Friends
                        </div>
                    </div>
                </div>
                
                <textarea 
                    class="post-textarea" 
                    placeholder="What's on your mind, <%= user.username || 'daro' %>?"
                ></textarea>

                <div class="upload-dropzone" onclick="document.getElementById('postFileInput').click()">
                    <div class="upload-title">
                        <span>📷</span> Add photos or videos
                    </div>
                    <div class="upload-subtitle">
                        Supports JPG, PNG, MP4, WebM up to 50MB
                    </div>
                    <input type="file" id="postFileInput" style="display: none;" multiple accept="image/*,video/*">
                </div>
            </div>
            <div class="modal-footer">
                <button class="submit-post-btn" onclick="closeCreatePostModal()">Post to Feed</button>
            </div>
