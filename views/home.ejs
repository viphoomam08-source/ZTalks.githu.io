    <!-- Lightbox Markup -->
    <div id="imageLightbox" class="lightbox" onclick="closeZoom()">
        <span class="close-btn" onclick="closeZoom()">&times;</span>
        <img id="zoomedImage" class="lightbox-img" alt="Zoomed View">
    </div>

    <!-- Platform Policy Modal -->
    <div id="policyModal" class="modal-overlay <%= showPolicyModal ? 'active' : '' %>" onclick="handleModalOverlayClick(event)">
        <div class="modal-card policy-modal-card">
            <div class="modal-header">
                <h3>Platform Policy & Terms</h3>
                <!-- Language Switcher -->
                <div class="lang-btn-group">
                    <button type="button" class="lang-btn active" id="btn-en" onclick="setPolicyLang('en')">EN</button>
                    <button type="button" class="lang-btn" id="btn-km" onclick="setPolicyLang('km')">ភាសាខ្មែរ</button>
                </div>
            </div>

            <div class="modal-body policy-scroll-body">
                <!-- English Content -->
                <div id="policy-content-en">
                    <h4>1. Our Mission</h4>
                    <p>Our platform is dedicated to sharing knowledge, fostering creativity, and building an inclusive educational community.</p>
                    
                    <h4>2. Acceptable Content Guidelines</h4>
                    <p>All shared content must inspire learning, skill development, and respectful engagement.</p>
                    
                    <h4>3. Prohibited Content</h4>
                    <p>Hate speech, harassment, fake news, and explicit content are strictly forbidden.</p>
                </div>

                <!-- Khmer Content -->
                <div id="policy-content-km" style="display: none;">
                    <h4>១. បេសកកម្មរបស់យើង</h4>
                    <p>វេទិការបស់យើងត្រូវបានបង្កើតឡើងដើម្បីចែករំលែកចំណេះដឹង លើកកម្ពស់គំនិតច្នៃប្រឌិត និងបង្កើតសហគមន៍អប់រំ។</p>
                    
                    <h4>២. គោលការណ៍ណែនាំ</h4>
                    <p>រាល់ខ្លឹមសារដែលបានចែករំលែកត្រូវតែផ្តល់តម្លៃអប់រំ និងការគោរពគ្នាទៅវិញទៅមក។</p>
                    
                    <h4>៣. ខ្លឹមសារហាមឃាត់</h4>
                    <p>ការប្រើប្រាស់ពាក្យសម្ដីអាក្រក់ ការរំលោភបំពាន និងព័ត៌មានមិនពិតត្រូវហាមឃាត់ដាច់ខាត់។</p>
                </div>
            </div>

            <!-- Policy Acceptance Footer -->
            <div class="modal-footer">
                <form action="/accept-policy" method="POST" id="policyForm" onsubmit="handlePolicySubmit(event)">
                    <button type="submit" class="modal-submit-btn">I Agree & Continue</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Client Controls Script -->
    <script>
        // Policy Modal Language Switcher
      
        function setPolicyLang(lang) {
            const en = document.getElementById('policy-content-en');
            const km = document.getElementById('policy-content-km');
            const btnEn = document.getElementById('btn-en');
            const btnKm = document.getElementById('btn-km');

            if (lang === 'km') {
                if (en) en.style.display = 'none';
                if (km) km.style.display = 'block';
                if (btnKm) btnKm.classList.add('active');
                if (btnEn) btnEn.classList.remove('active');
            } else {
                if (km) km.style.display = 'none';
                if (en) en.style.display = 'block';
                if (btnEn) btnEn.classList.add('active');
                if (btnKm) btnKm.classList.remove('active');
            }
        }

        // Handle Policy Form Submit
        function handlePolicySubmit(event) {
            // Allows the form to natively post to /accept-policy or custom handler
        }

        // Modal Handlers
        function openCreatePostModal() {
            const modal = document.getElementById('createPostModal');
            if (modal) modal.style.display = 'flex';
        }

        function closeCreatePostModal() {
            const modal = document.getElementById('createPostModal');
            if (modal) modal.style.display = 'none';
        }

        function handleModalOverlayClick(event) {
            if (event.target.classList.contains('modal-overlay')) {
                event.target.style.display = 'none';
                event.target.classList.remove('active');
            }
        }

        // Follow/Unfollow Toggle
        function toggleFollow(btnElement) {
            if (btnElement.classList.contains('followed')) {
                btnElement.classList.remove('followed');
                btnElement.innerHTML = '<span>+</span> Follow';
            } else {
                btnElement.classList.add('followed');
                btnElement.innerHTML = '<span>✓</span> Following';
            }
        }

        // Lightbox Zoom Controls
        function zoomImage(element) {
            const lightbox = document.getElementById("imageLightbox");
            const zoomedImg = document.getElementById("zoomedImage");
            
            if (lightbox && zoomedImg) {
                lightbox.style.display = "flex"; 
                zoomedImg.src = element.src; 
            }
        }

        function closeZoom() {
            const lightbox = document.getElementById("imageLightbox");
            if (lightbox) lightbox.style.display = "none";
        }

        // Account Link Navigation
        function openAccount() {
            window.location.href = '/account';
        }

        // Tab View Switching
        function switchView(viewId, buttonElement) {
            document.querySelectorAll('.menu-tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.view-panel').forEach(panel => panel.classList.remove('active-view'));
            
            if (buttonElement) buttonElement.classList.add('active');
            const targetPanel = document.getElementById(viewId);
            if (targetPanel) targetPanel.classList.add('active-view');
        }

        // Like Count Toggle
       function toggleLike(btn) {
    btn.classList.toggle('liked');
    const countSpan = btn.querySelector('.like-count');
    let currentCount = parseInt(countSpan.textContent, 10) || 0;

    if (btn.classList.contains('liked')) {
        countSpan.textContent = currentCount + 1;
    } else {
        countSpan.textContent = Math.max(0, currentCount - 1);
    }
}

function toggleSave(btn) {
    btn.classList.toggle('saved');
    const label = btn.querySelector('.save-label');
    if (btn.classList.contains('saved')) {
        label.textContent = 'Saved';
    } else {
        label.textContent = 'Save';
    }
}

function toggleCommentsSection(sectionId) {
    const targetsContainer = document.getElementById(sectionId);
    
    // Safety check if element exists
    if (!targetsContainer) {
        console.error("Could not find section with ID:", sectionId);
        return;
    }

    // Get current actual display property (handles CSS stylesheets)
    const currentDisplay = window.getComputedStyle(targetsContainer).display;

    if (currentDisplay === "none") {
        targetsContainer.style.display = "block";
    } else {
        targetsContainer.style.display = "none";
    }
}

function sharePost() {
    console.log('Share clicked');
}
        // Comments Drawer Toggle
        function toggleCommentsSection(sectionId) {
            const targetsContainer = document.getElementById(sectionId);
if (targetsContainer.style.display === "none" || !targetsContainer.style.display)
            if (targetsContainer.style.display === "none" || !targetsContainer.style.display) {
                targetsContainer.style.display = "block";
            } else {
                targetsContainer.style.display = "none";
            }
        }

        // Comment Handlers
        function handleCommentSubmit(event, sectionId, inputElement) {
            if (event.key === 'Enter' && inputElement.value.trim() !== "") {
                injectCommentElement(sectionId, inputElement);
            }
        }

        function addCommentDirectly(sectionId) {
            const wrapper = document.getElementById(sectionId);
            if (!wrapper) return;
            const inputElement = wrapper.querySelector('.comment-input-inline input');
            if (inputElement && inputElement.value.trim() !== "") {
                injectCommentElement(sectionId, inputElement);
            }
        }

        // Share Link Functionality
        function sharePost(postId) {
            const postUrl = `${window.location.origin}/post/${postId}`;

            if (navigator.share) {
                navigator.share({
                    title: 'Check out this post on GenZ Talk!',
                    url: postUrl
                }).catch(() => {});
            } else {
                navigator.clipboard.writeText(postUrl).then(() => {
                    alert('Post link copied to clipboard!');
                });
            }
        }

        // Dynamic Comment Injection Helper
        function injectCommentElement(sectionId, inputElement) {
            const wrapper = document.getElementById(sectionId);
            if (!wrapper) return;
            
            const listContainer = wrapper.querySelector('.comments-list');
            const mediaCard = wrapper.closest('.media-card');
            const counterSpan = mediaCard ? mediaCard.querySelector('.comment-count') : null;
            
            if (listContainer) {
                const newComment = document.createElement('div');
                newComment.className = 'single-comment';
                newComment.innerHTML = `<strong>@user</strong> ${escapeHTML(inputElement.value)}`;
                
                listContainer.appendChild(newComment);
                
                if (counterSpan) {
                    counterSpan.innerText = (parseInt(counterSpan.innerText) || 0) + 1;
                }
                
                inputElement.value = "";
                listContainer.scrollTop = listContainer.scrollHeight;
            }
        }

        // XSS Prevention Helper
        function escapeHTML(str) {
            return str.replace(/[&<>'"]/g, 
                tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
            );
        }
        const socket = io();

    // 1. Connection Event Listeners
    socket.on('connect', () => {
        console.log('Connected to server with Socket ID:', socket.id);
        
        // Optionally join a room or send initial user data
        socket.emit('register_user', {
            username: '<%= user.username || "Guest" %>'
        });
    });

    socket.on('disconnect', () => {
        console.warn('Disconnected from server');
    });

    // 2. RECEIVE REAL-TIME MESSAGES / COMMENTS
    // Listen for new comments broadcast by the server
    socket.on('new_comment', (data) => {
        // data structure: { postId: '123', username: 'alex', text: 'Hey there!' }
        const targetContainer = document.getElementById('comments-post-' + data.postId);
        if (targetContainer) {
            const commentsList = targetContainer.querySelector('.comments-list');
            if (commentsList) {
                const commentEl = document.createElement('div');
                commentEl.className = 'single-comment';
                commentEl.innerHTML = `<strong>@${data.username}</strong> ${data.text}`;
                commentsList.appendChild(commentEl);
                
                // Auto-scroll to the bottom of comments
                commentsList.scrollTop = commentsList.scrollHeight;
            }
        }
    });

    // 3. SEND COMMENTS VIA SOCKET
    function sendSocketComment(postId, inputEl) {
        const text = inputEl.value.trim();
        if (!text) return;

        // Emit the event to the server
        socket.emit('send_comment', {
            postId: postId,
            username: '<%= user.username || "Anonymous" %>',
            text: text
        });

        // Clear input box
        inputEl.value = '';
    }

    // 4. Keyboard Listener for Comment Input Box
    function handleCommentSubmit(event, containerId, inputEl) {
        if (event.key === 'Enter') {
            event.preventDefault();
            // Extract the numerical or raw ID from containerId (e.g. 'comments-post-12' -> '12')
            const postId = containerId.replace('comments-post-', '');
            sendSocketComment(postId, inputEl);
        }
    }

    // Helper button trigger for comment posting
    function addCommentDirectly(containerId) {
        const container = document.getElementById(containerId);
        if (!container) return;
        const inputEl = container.querySelector('input');
        if (inputEl) {
            const postId = containerId.replace('comments-post-', '');
            sendSocketComment(postId, inputEl);
        }
    }
    </script>
</body>
</html>