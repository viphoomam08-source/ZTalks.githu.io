<!DOCTYPE html>
<html lang="km">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StudyScout - Knowledge Sharing Platform</title>
  
  <!-- Google Fonts for Khmer Support -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Koh+Santepheap:wght@400;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <style>
    body {
      font-family: 'Plus Jakarta Sans', 'Koh Santepheap', sans-serif;
    }
  </style>
</head>
<body class="bg-slate-50/50 text-slate-800 min-h-screen pb-16 antialiased">

  <!-- Navigation Bar -->
  <header class="border-b border-slate-200/80 bg-white/80 backdrop-blur-md sticky top-0 z-50 shadow-xs">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 to-indigo-500 flex items-center justify-center text-white font-bold shadow-md shadow-indigo-500/20">
          <i data-lucide="book-open-check" class="w-5 h-5"></i>
        </div>
        <div>
          <h1 class="text-lg font-bold text-slate-900 tracking-tight leading-tight">StudyScout</h1>
          <p class="text-[11px] text-slate-500 font-medium hidden sm:block">ប្រព័ន្ធរៀនឌីជីថល / Digital Knowledge Hub</p>
        </div>
      </div>
      
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 bg-indigo-50 text-indigo-700 border border-indigo-100 rounded-full">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-600 animate-pulse"></span>
          v4.0 Hub
        </span>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 mt-8 space-y-8">

    <!-- Post Creation / Upload Form -->
    <div class="bg-white border border-slate-200/80 rounded-2xl p-6 sm:p-7 shadow-sm transition-all hover:shadow-md">
      <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
        <div>
          <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <i data-lucide="plus-circle" class="w-5 h-5 text-indigo-600"></i>
            ចែករំលែកឯកសារ / Upload Resource
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">បញ្ចូលមេរៀនថ្មីទៅកាន់ប្រព័ន្ធដេប៉ូ Knowledge Library</p>
        </div>
      </div>

      <form action="/knowledge" method="POST" enctype="multipart/form-data" id="postForm" class="space-y-5">        
        <div>
          <label class="block text-xs font-bold text-slate-700 tracking-wider uppercase mb-1.5">
            ចំណងជើងមេរៀន (Title) <span class="text-rose-500">*</span>
          </label>
          <input 
            type="text" 
            id="postTitle" 
            required 
            name="title"
            placeholder="ឧទាហរណ៍: មូលដ្ឋានគ្រឹះ HTML & CSS ភាសាខ្មែរ"
            class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-slate-800 text-sm focus:outline-none focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-500/10 transition-all placeholder:text-slate-400"
          >
        </div>

        <!-- Description -->
        <div>
          <label class="block text-xs font-bold text-slate-700 tracking-wider uppercase mb-1.5">
            ការពិពណ៌នាសង្ខេប (Description)
          </label>
          <textarea 
            id="postDescription" 
            rows="2"
            name="description"
            placeholder="រៀបរាប់សង្ខេបអំពីខ្លឹមសារនៃមេរៀននេះ..."
            class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-slate-800 text-sm focus:outline-none focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-500/10 transition-all placeholder:text-slate-400 resize-none"
          ></textarea>
        </div>

        <!-- Metadata Selectors Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          
          <!-- Resource Type -->
          <div>
            <label class="block text-xs font-bold text-slate-700 tracking-wider uppercase mb-1.5">
              ប្រភេទ (Type) <span class="text-rose-500">*</span>
            </label>
            <select id="resourceType" name="resource_type" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-800 text-sm focus:outline-none focus:border-indigo-500 focus:bg-white transition-all cursor-pointer">
              <option value="PDF">📄 PDF Document</option>
              <option value="VIDEO">🎥 Video Lesson</option>
            </select>
          </div>

          <!-- Subject -->
          <div>
            <label class="block text-xs font-bold text-slate-700 tracking-wider uppercase mb-1.5">
              មុខវិជ្ជា (Subject) <span class="text-rose-500">*</span>
            </label>
            <select id="typeSubject" name="type_subject" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-800 text-sm focus:outline-none focus:border-indigo-500 focus:bg-white transition-all cursor-pointer">
              <option value="CODING">💻 Coding / IT</option>
              <option value="MATH">📐 Math (គណិតវិទ្យា)</option>
              <option value="PHYSICS">⚡ Physics (រូបវិទ្យា)</option>
              <option value="CHEMISTRY">🧪 Chemistry (គីមីវិទ្យា)</option>
              <option value="BIOLOGY">🧬 Biology (ជីវវិទ្យា)</option>
              <option value="KHMER">🇰🇭 Khmer (ភាសាខ្មែរ)</option>
              <option value="ENGLISH">🇬🇧 English</option>
              <option value="GEOGRAPHY">🌍 Geography (ភូមិវិទ្យា)</option>
              <option value="HISTORY">🏛️ History (ប្រវត្តិវិទ្យា)</option>
            </select>
          </div>

          <!-- Grade Level -->
          <div>
            <label class="block text-xs font-bold text-slate-700 tracking-wider uppercase mb-1.5">
              កម្រិតថ្នាក់ (Grade) <span class="text-rose-500">*</span>
            </label>
            <select id="grade" name="grade" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-800 text-sm focus:outline-none focus:border-indigo-500 focus:bg-white transition-all cursor-pointer">
              <option value="GRADE_7">ថ្នាក់ទី ៧</option>
              <option value="GRADE_8">ថ្នាក់ទី ៨</option>
              <option value="GRADE_9">ថ្នាក់ទី ៩</option>
              <option value="GRADE_10">ថ្នាក់ទី ១០</option>
              <option value="GRADE_11">ថ្នាក់ទី ១១</option>
              <option value="GRADE_12">ថ្នាក់ទី ១២</option>
              <option value="UNIVERSITY">មហាវិទ្យាល័យ / ទូទៅ</option>
              <option value="ALL">គ្រប់កម្រិត</option>
            </select>
          </div>
        </div>

        <!-- File Upload Drag Drop Area -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          
          <!-- Video Input Zone -->
          <div class="group relative border-2 border-dashed border-slate-200 hover:border-indigo-400 rounded-xl p-4 text-center transition-all bg-slate-50/50 hover:bg-indigo-50/30 cursor-pointer">
            <input type="file" id="videoFile" name="video" accept="video/*" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10">
            <div class="flex flex-col items-center gap-1.5 pointer-events-none">
              <div class="p-2.5 bg-indigo-50 group-hover:bg-indigo-100 text-indigo-600 rounded-xl transition-colors">
                <i data-lucide="video" class="w-5 h-5"></i>
              </div>
              <span class="text-xs font-semibold text-slate-700" id="videoLabel">Attach Video (.mp4)</span>
              <span class="text-[10px] text-slate-400">Max file size: 50MB</span>
            </div>
          </div>

          <!-- PDF Input Zone -->
          <div class="group relative border-2 border-dashed border-slate-200 hover:border-rose-400 rounded-xl p-4 text-center transition-all bg-slate-50/50 hover:bg-rose-50/30 cursor-pointer">
            <input type="file" id="pdfFile" name="pdf" accept="application/pdf" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10">
            <div class="flex flex-col items-center gap-1.5 pointer-events-none">
              <div class="p-2.5 bg-rose-50 group-hover:bg-rose-100 text-rose-600 rounded-xl transition-colors">
                <i data-lucide="file-text" class="w-5 h-5"></i>
              </div>
              <span class="text-xs font-semibold text-slate-700" id="pdfLabel">Attach Document (.pdf)</span>
              <span class="text-[10px] text-slate-400">Max file size: 10MB</span>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <button 
          type="submit" 
          id="submitBtn"
          class="w-full bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold py-3 rounded-xl transition-all shadow-md shadow-indigo-600/20 text-sm flex items-center justify-center gap-2 cursor-pointer mt-2"
        >
          <i data-lucide="upload-cloud" class="w-4 h-4"></i>
          Publish Knowledge Resource
        </button>
      </form>
    </div>

    <!-- Category Filter Bar -->
    <div class="bg-white border border-slate-200/80 rounded-2xl p-4 shadow-sm space-y-3">
      <div class="flex items-center justify-between">
        <h3 class="text-xs font-bold text-slate-400 tracking-wider uppercase flex items-center gap-2">
          <i data-lucide="filter" class="w-4 h-4"></i>
          Filter by Category & Subject
        </h3>
        <button onclick="filterPosts('ALL', this)" class="text-xs text-indigo-600 hover:underline font-semibold">Reset Filters</button>
      </div>

      <div class="flex flex-wrap gap-2" id="filterContainer">
        <button onclick="filterPosts('ALL', this)" class="filter-btn active text-xs font-medium px-3 py-1.5 rounded-lg bg-indigo-600 text-white transition-all">All Resources</button>
        <button onclick="filterPosts('CODING', this)" class="filter-btn text-xs font-medium px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition-all">💻 Coding</button>
        <button onclick="filterPosts('MATH', this)" class="filter-btn text-xs font-medium px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition-all">📐 Math</button>
        <button onclick="filterPosts('PHYSICS', this)" class="filter-btn text-xs font-medium px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition-all">⚡ Physics</button>
        <button onclick="filterPosts('CHEMISTRY', this)" class="filter-btn text-xs font-medium px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition-all">🧪 Chemistry</button>
        <button onclick="filterPosts('PDF', this)" class="filter-btn text-xs font-medium px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition-all">📄 PDF Only</button>
        <button onclick="filterPosts('VIDEO', this)" class="filter-btn text-xs font-medium px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition-all">🎥 Videos Only</button>
      </div>
    </div>

    <!-- Feed Section -->
    <div class="space-y-4">
      <div class="flex items-center justify-between px-1">
        <h3 class="text-xs font-bold text-slate-400 tracking-wider uppercase flex items-center gap-2">
          <i data-lucide="layers" class="w-4 h-4"></i>
          Recent Knowledge Feed
        </h3>
        <span class="text-xs text-slate-400" id="itemCount">Showing all posts</span>
      </div>

      <!-- Feed Cards Container -->
      <div class="space-y-4" id="feedContainer">
        <!-- Dynamic Cards Inserted Here -->
      </div>
    </div>

  </main>

  <!-- Edit Post Modal -->
  <div id="editModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4 z-50 hidden">
    <div class="bg-white rounded-2xl p-6 max-w-lg w-full space-y-4 shadow-xl border border-slate-100">
      <div class="flex items-center justify-between border-b pb-3">
        <h3 class="font-bold text-slate-800 text-base flex items-center gap-2">
          <i data-lucide="edit-3" class="w-4 h-4 text-indigo-600"></i>
          Update Resource
        </h3>
        <button onclick="closeEditModal()" class="text-slate-400 hover:text-slate-600">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <form id="editForm" class="space-y-4">
        <input type="hidden" id="editPostId">
        
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Title</label>
          <input type="text" id="editTitle" required class="w-full bg-slate-50 border rounded-xl px-3 py-2 text-sm">
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Description</label>
          <textarea id="editDescription" rows="3" class="w-full bg-slate-50 border rounded-xl px-3 py-2 text-sm resize-none"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Subject</label>
            <select id="editSubject" class="w-full bg-slate-50 border rounded-xl px-3 py-2 text-sm">
              <option value="CODING">💻 Coding</option>
              <option value="MATH">📐 Math</option>
              <option value="PHYSICS">⚡ Physics</option>
              <option value="CHEMISTRY">🧪 Chemistry</option>
              <option value="BIOLOGY">🧬 Biology</option>
              <option value="KHMER">🇰🇭 Khmer</option>
              <option value="ENGLISH">🇬🇧 English</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Grade</label>
            <select id="editGrade" class="w-full bg-slate-50 border rounded-xl px-3 py-2 text-sm">
              <option value="GRADE_7">ថ្នាក់ទី ៧</option>
              <option value="GRADE_8">ថ្នាក់ទី ៨</option>
              <option value="GRADE_9">ថ្នាក់ទី ៩</option>
              <option value="GRADE_10">ថ្នាក់ទី ១០</option>
              <option value="GRADE_11">ថ្នាក់ទី ១១</option>
              <option value="GRADE_12">ថ្នាក់ទី ១២</option>
              <option value="UNIVERSITY">មហាវិទ្យាល័យ</option>
            </select>
          </div>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button type="button" onclick="closeEditModal()" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg">Cancel</button>
          <button type="submit" id="editSubmitBtn" class="px-4 py-2 text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg shadow-sm">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // 1. RECEIVE DATA DIRECTLY FROM EXPRESS CONTROLLER VIA EJS
    let rawPosts = <%- JSON.stringify(typeof Dipslay !== 'undefined' ? Dipslay : []) %>;

    // Initialize Lucide icons
    lucide.createIcons();

    // Initial render
    document.addEventListener("DOMContentLoaded", () => {
      renderFeed(rawPosts);
    });

    // Input zone file selection previews
    document.getElementById('videoFile').addEventListener('change', (e) => {
      const fileName = e.target.files[0]?.name;
      if (fileName) {
        document.getElementById('videoLabel').innerText = fileName;
        document.getElementById('videoLabel').classList.add('text-indigo-600');
      }
    });

    document.getElementById('pdfFile').addEventListener('change', (e) => {
      const fileName = e.target.files[0]?.name;
      if (fileName) {
        document.getElementById('pdfLabel').innerText = fileName;
        document.getElementById('pdfLabel').classList.add('text-rose-600');
      }
    });

    // Submit New Post (POST Endpoint)
    document.getElementById('postForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const btn = document.getElementById('submitBtn');
      btn.innerText = 'Publishing...';
      btn.disabled = true;

      const formData = new FormData();
      formData.append('title', document.getElementById('postTitle').value);
      formData.append('description', document.getElementById('postDescription').value);
      formData.append('resource_type', document.getElementById('resourceType').value);
      formData.append('type_subject', document.getElementById('typeSubject').value);
      formData.append('grade', document.getElementById('grade').value);

      const videoInput = document.getElementById('videoFile').files[0];
      const pdfInput = document.getElementById('pdfFile').files[0];

      if (videoInput) formData.append('video', videoInput);
      if (pdfInput) formData.append('pdf', pdfInput);

      try {
        const response = await fetch('/knowledge', {
          method: 'POST',
          body: formData  
        });

        if (response.ok) {
          document.getElementById('postForm').reset();
          document.getElementById('videoLabel').innerText = 'Attach Video (.mp4)';
          document.getElementById('videoLabel').classList.remove('text-indigo-600');
          document.getElementById('pdfLabel').innerText = 'Attach Document (.pdf)';
          document.getElementById('pdfLabel').classList.remove('text-rose-600');
          
          window.location.reload(); 
        } else {
          alert('Upload failed. Please check field inputs and file types.');
        }
      } catch (err) {
        console.error('Upload Error:', err);
      } finally {
        btn.innerHTML = `<i data-lucide="upload-cloud" class="w-4 h-4"></i> Publish Knowledge Resource`;
        btn.disabled = false;
        lucide.createIcons();
      }
    });

    // Submit Edited Post (PUT Endpoint)
    document.getElementById('editForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const id = document.getElementById('editPostId').value;
      const btn = document.getElementById('editSubmitBtn');
      btn.innerText = 'Saving...';
      btn.disabled = true;

      const payload = {
        title: document.getElementById('editTitle').value,
        description: document.getElementById('editDescription').value,
        type_subject: document.getElementById('editSubject').value,
        grade: document.getElementById('editGrade').value
      };

      try {
        const response = await fetch(`/knowledge/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Failed to update resource.');
        }
      } catch (err) {
        console.error('Update Error:', err);
      } finally {
        btn.innerText = 'Save Changes';
        btn.disabled = false;
      }
    });

    // Helper: Grade Label Formatter
    function formatGrade(grade) {
      const map = {
        'GRADE_7': 'ថ្នាក់ទី ៧',
        'GRADE_8': 'ថ្នាក់ទី ៨',
        'GRADE_9': 'ថ្នាក់ទី ៩',
        'GRADE_10': 'ថ្នាក់ទី ១០',
        'GRADE_11': 'ថ្នាក់ទី ១១',
        'GRADE_12': 'ថ្នាក់ទី ១២',
        'UNIVERSITY': 'មហាវិទ្យាល័យ',
        'ALL': 'គ្រប់កម្រិត'
      };
      return map[grade] || grade;
    }

    // Helper: Generic Avatar Circle Generator
    function renderAvatarCircle(photo, emoji, name, sizeClasses = "w-8 h-8", textClass = "text-xs") {
      const authorName = name || 'អ្នកប្រើប្រាស់';
      
      if (photo) {
        return `<img src="${photo}" class="${sizeClasses} rounded-full object-cover border border-slate-200 shrink-0" alt="${authorName}">`;
      } else if (emoji) {
        return `<div class="${sizeClasses} rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center ${textClass} shrink-0">${emoji}</div>`;
      } else {
        return `<div class="${sizeClasses} rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center ${textClass} shrink-0">${authorName.charAt(0).toUpperCase()}</div>`;
      }
    }

    // Render Post Avatar
    function renderAvatar(post) {
      const name = post.author_name || post.username || 'អ្នកប្រើប្រាស់';
      return renderAvatarCircle(post.Photo, post.emoji_char, name, "w-8 h-8", "text-xs");
    }

    // Render Commenter Avatar
    function renderCommenterAvatar(comment) {
      const name = comment.author || 'អ្នកប្រើប្រាស់';
      return renderAvatarCircle(comment.photo, comment.emoji, name, "w-6 h-6", "text-[10px]");
    }

    // Toggle Like Status
    function toggleLike(postId) {
      const post = rawPosts.find(p => String(p.id) === String(postId));
      if (!post) return;

      post.isLiked = !post.isLiked;
      post.likesCount = (post.likesCount || 0) + (post.isLiked ? 1 : -1);

      renderFeed(rawPosts);
    }

    // Toggle Saved Status
    function toggleSave(postId) {
      const post = rawPosts.find(p => String(p.id) === String(postId));
      if (!post) return;

      post.isSaved = !post.isSaved;
      renderFeed(rawPosts);
    }

    // Toggle Comment Drawer Visibility & Focus Input
    function toggleComments(postId) {
      const commentDrawer = document.getElementById(`comments-${postId}`);
      if (commentDrawer) {
        const isHidden = commentDrawer.classList.contains('hidden');
        commentDrawer.classList.toggle('hidden');
        
        if (isHidden) {
          setTimeout(() => {
            const commentInput = document.getElementById(`comment-input-${postId}`);
            if (commentInput) commentInput.focus();
          }, 50);
        }
      }
    }

    // Add New Comment
    function addComment(event, postId) {
      event.preventDefault();
      const input = document.getElementById(`comment-input-${postId}`);
      const text = input.value.trim();

      if (!text) return;

      const post = rawPosts.find(p => String(p.id) === String(postId));
      if (!post) return;

      if (!post.comments) post.comments = [];
      post.comments.push({
        author: 'អ្នកប្រើប្រាស់',
        text: text,
        time: 'Just now'
      });

      input.value = '';
      renderFeed(rawPosts);
      
      // Keep drawer open after adding comment
      const commentDrawer = document.getElementById(`comments-${postId}`);
      if (commentDrawer) commentDrawer.classList.remove('hidden');
    }

    // Share Link Handler
    function sharePost(postId) {
      const shareUrl = `${window.location.origin}/knowledge#post-${postId}`;
      navigator.clipboard.writeText(shareUrl).then(() => {
        alert('តំណភ្ជាប់ត្រូវបានចម្លង (Post Link copied to clipboard!)');
      }).catch(err => {
        console.error('Failed to copy link:', err);
      });
    }

    // Render Feed Array to UI
    function renderFeed(posts) {
      const container = document.getElementById('feedContainer');

      if (!posts || posts.length === 0) {
        container.innerHTML = `
          <div class="bg-white border border-slate-200 rounded-2xl p-8 text-center text-slate-400">
            <i data-lucide="inbox" class="w-8 h-8 mx-auto mb-2 opacity-50"></i>
            <p class="text-sm">មិនទាន់មានទិន្នន័យនៅឡើយទេ (No posts found)</p>
          </div>`;
        lucide.createIcons();
        return;
      }

      container.innerHTML = posts.map((post, index) => {
        const isLiked = !!post.isLiked;
        const isSaved = !!post.isSaved;
        const likesCount = post.likesCount || 0;
        const commentsList = post.comments || [];

        return `
        <div id="post-${post.id}" class="bg-white border border-slate-200/80 rounded-2xl p-5 sm:p-6 space-y-4 shadow-sm hover:shadow-md transition-all relative">
          
          <!-- Post Header -->
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-start gap-3">
              <span class="text-xs font-extrabold px-2 py-1 bg-slate-100 text-slate-500 rounded-lg border border-slate-200/60">
                #${index + 1}
              </span>

              ${renderAvatar(post)}

              <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-md bg-indigo-50 text-indigo-700 border border-indigo-100 uppercase">
                    ${post.type_subject}
                  </span>
                  <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-md bg-slate-100 text-slate-600">
                    ${formatGrade(post.grade)}
                  </span>
                </div>
                <h4 class="font-bold text-slate-900 text-base sm:text-lg leading-snug">${post.title}</h4>
              </div>
            </div>
            
            <div class="flex items-center gap-1">
              <button onclick="openEditModal('${post.id}')" class="p-1.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors" title="Update / Edit">
                <i data-lucide="edit-3" class="w-4 h-4"></i>
              </button>
              <button onclick="deletePost('${post.knowledge_id}')" class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors" title="Delete">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
              </button>
            </div>
          </div>

          <!-- Description -->
          ${post.description ? `<p class="text-xs sm:text-sm text-slate-600 leading-relaxed pl-1">${post.description}</p>` : ''}

          <!-- Video Player -->
          ${post.video_url ? `
            <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-900 aspect-video max-h-96">
              <video controls class="w-full h-full object-contain">
                <source src="${post.video_url}" type="video/mp4">
                Your browser does not support HTML video.
              </video>
            </div>
          ` : ''}

          <!-- PDF Card -->
          ${post.pdf_url ? `
            <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 hover:border-slate-300 transition-colors">
              <div class="flex items-center gap-3">
                <div class="p-2.5 bg-rose -100/70 text-rose-600 rounded-xl">
                  <i data-lucide="file-text" class="w-5 h-5"></i>
                </div>
                <div>
                  <p class="text-xs font-bold text-slate-800">ឯកសារមេរៀន (PDF Resource)</p>
                  <p class="text-[10px] text-slate-500">Click to view or download PDF</p>
                </div>
              </div>
              <a 
                href="${post.pdf_url}" 
                target="_blank" 
                class="text-xs font-semibold px-3.5 py-2 bg-white hover:bg-slate-100 text-indigo-600 border border-slate-200 rounded-lg transition-all shadow-xs flex items-center gap-1.5"
              >
                <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                បើកមើល PDF
              </a>
            </div>
          ` : ''}

          <!-- Post Action Bar -->
          <div class="flex items-center justify-between pt-3 border-t border-slate-100">
            <div class="flex items-center gap-1">
              
              <button 
                onclick="toggleLike('${post.id}')" 
                class="flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-lg transition-colors ${
                  isLiked ? 'text-rose-600 bg-rose-50' : 'text-slate-600 hover:bg-slate-100'
                }"
              >
                <i data-lucide="heart" class="w-4 h-4 ${isLiked ? 'fill-rose-600' : ''}"></i>
                <span>${likesCount}</span>
              </button>

              <button 
                onclick="toggleComments('${post.id}')" 
                class="flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 text-slate-600 hover:bg-slate-100 rounded-lg transition-colors"
              >
                <i data-lucide="message-square" class="w-4 h-4"></i>
                <span>${commentsList.length}</span>
              </button>

              <button 
                onclick="sharePost('${post.id}')" 
                class="flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 text-slate-600 hover:bg-slate-100 rounded-lg transition-colors"
              >
                <i data-lucide="share-2" class="w-4 h-4"></i>
                <span class="hidden sm:inline">Share</span>
              </button>

            </div>

            <button 
              onclick="toggleSave('${post.id}')" 
              class="flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-lg transition-colors ${
                isSaved ? 'text-indigo-600 bg-indigo-50' : 'text-slate-600 hover:bg-slate-100'
              }"
            >
              <i data-lucide="bookmark" class="w-4 h-4 ${isSaved ? 'fill-indigo-600' : ''}"></i>
              <span class="hidden sm:inline">${isSaved ? 'Saved' : 'Save'}</span>
            </button>
          </div>

          <!-- Comments Drawer Section -->
          <div id="comments-${post.id}" class="hidden space-y-3 pt-3 border-t border-slate-100">
            <div class="space-y-2 max-h-40 overflow-y-auto pr-1">
              ${commentsList.length > 0 ? commentsList.map(c => `
                <div class="bg-slate-50 p-2.5 rounded-xl text-xs space-y-1">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      ${renderCommenterAvatar(c)}
                      <span class="font-bold text-slate-800">${c.author}</span>
                    </div>
                    <span class="text-[10px] text-slate-400">${c.time}</span>
                  </div>
                  <p class="text-slate-600 pl-8">${c.text}</p>
                </div>
              `).join('') : '<p class="text-xs text-slate-400 italic text-center py-2">មិនទាន់មានមតិយោបល់នៅឡើយទេ (No comments yet)</p>'}
            </div>

            <form onsubmit="addComment(event, '${post.id}')" class="flex gap-2">
              <input 
                type="text" 
                id="comment-input-${post.id}" 
                placeholder="សរសេរមតិរបស់អ្នក..." 
                class="flex-1 bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 text-xs focus:outline-none focus:border-indigo-500"
              >
              <button 
                type="submit" 
                class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-semibold"
              >
                Send
              </button>
            </form>
          </div>

        </div>
      `;
      }).join('');

      lucide.createIcons();
    }

    // Category Filter Handler
    function filterPosts(category, buttonElement) {
      if (buttonElement) {
        const buttons = document.querySelectorAll('#filterContainer .filter-btn');
        buttons.forEach(btn => {
          btn.className = 'filter-btn text-xs font-medium px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition-all';
        });
        buttonElement.className = 'filter-btn active text-xs font-medium px-3 py-1.5 rounded-lg bg-indigo-600 text-white transition-all';
      }

      if (category === 'ALL') {
        renderFeed(rawPosts);
        document.getElementById('itemCount').innerText = `Showing all posts (${rawPosts.length})`;
        return;
      }

      const filtered = rawPosts.filter(post => {
        if (post.type_subject === category) return true;

        if (category === 'PDF') {
          return post.resource_type === 'PDF' || (post.pdf_url && post.pdf_url.trim() !== '');
        }
        if (category === 'VIDEO') {
          return post.resource_type === 'VIDEO' || (post.video_url && post.video_url.trim() !== '');
        }

        return false;
      });

      renderFeed(filtered);
      document.getElementById('itemCount').innerText = `Filtered: ${filtered.length} items`;
    }

    // Delete Post Handler (DELETE Endpoint)
  // Delete Post Function
// Delete Post Function
async function deletePost(postId) {
  if (!confirm('តើអ្នកប្រាកដជាចង់លុបឯកសារនេះមែនទេ? (Are you sure you want to delete this resource?)')) {
    return;
  }

  try {
    const response = await fetch(`/knowledge/${postId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json'
      }
    });

    const result = await response.json();

    if (response.ok) {
      // 1. Instantly remove card from DOM screen without full re-render
      const postCard = document.getElementById(`post-${postId}`);
      if (postCard) {
        postCard.remove();
      }

      // 2. Remove from local rawPosts array (handles both knowledge_id and id)
      rawPosts = rawPosts.filter(p => String(p.knowledge_id || p.id) !== String(postId));

      // 3. Update total count label instantly
      const countLabel = document.getElementById('itemCount');
      if (countLabel) {
        countLabel.innerText = `Showing all posts (${rawPosts.length})`;
      }

      // 4. If no posts left, render empty state
      if (rawPosts.length === 0) {
        renderFeed([]);
      }

    } else {
      alert('កំហុសក្នុងការលុប: ' + (result.error || 'Failed to delete'));
    }
  } catch (err) {
    console.error('Delete Error:', err);
    alert('Server error occurred while deleting.');
  }
}
    // Modal Control Functions
    function openEditModal(id) {
      const post = rawPosts.find(p => String(p.id) === String(id));
      if (!post) return;

      document.getElementById('editPostId').value = post.id;
      document.getElementById('editTitle').value = post.title || '';
      document.getElementById('editDescription').value = post.description || '';
      document.getElementById('editSubject').value = post.type_subject || 'CODING';
      document.getElementById('editGrade').value = post.grade || 'ALL';

      document.getElementById('editModal').classList.remove('hidden');
    }

    function closeEditModal() {
      document.getElementById('editModal').classList.add('hidden');
    }
  </script>
</body>
</html>