<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GenZ Talk - Welcome</title>
    <style>
        /* Modern CSS Reset & Core Styling */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #f4f7f6;
            color: #333;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        /* Main Layout Wrapper */
        .container {
            width: 100%;
            max-width: 900px;
            background: #ffffff;
            display: flex;
            flex-direction: row;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

        /* Left Side: Welcome Screen */
        .child {
            flex: 1;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #ffffff;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .child h1.brand {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 20px;
            letter-spacing: -0.5px;
        }

        .child h2.welcome {
            font-size: 1.5rem;
            font-weight: 400;
            opacity: 0.9;
            margin-bottom: 8px;
        }

        .child p.role {
            font-size: 1rem;
            opacity: 0.75;
        }

        /* Right Side: Shared Form Styling for Register & Login */
        .Register, .Login {
            flex: 1;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .Register h3, .Login h3 {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 25px;
            color: #2d3748;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            margin-bottom: 20px;
        }

        .Register label, .Login label {
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 6px;
            color: #718096;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .Register input, .Login input {
            padding: 12px 16px;
            font-size: 1rem;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            outline: none;
            transition: all 0.2s ease-in-out;
        }

        .Register input:focus, .Login input:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
        }

        .Register button, .Login button {
            margin-top: 10px;
            padding: 14px;
            font-size: 1rem;
            font-weight: 600;
            color: #ffffff;
            background-color: #667eea;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .Register button:hover, .Login button:hover {
            background-color: #5a67d8;
        }

        /* Toggle Link Styling */
        .toggle-link {
            text-align: center;
            margin-top: 20px;
            font-size: 0.9rem;
            color: #718096;
        }

        .toggle-link a {
            color: #667eea;
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
        }

        .toggle-link a:hover {
            text-decoration: underline;
        }

        /* Clean Red Banner Style for Errors */
        .error-banner {
            background-color: #ffe8ec;
            color: #e53e3e;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #fed7d7;
            margin-bottom: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            text-align: center;
        }

        /* FIX: Utility Class to hide inactive forms */
        .hidden {
            display: none !important;
        }

        @media (max-width: 768px) {
            .container {
                flex-direction: column;
            }
            .child {
                padding: 30px;
                text-align: center;
                align-items: center;
            }
            .Register, .Login {
                padding: 30px;
            }
        }
    </style>
</head>
<body>

  <div class="container">
    <!-- Left branding panel -->
    <div class="child">
        <h1 class="brand">GenZ Talk</h1>
       
    </div>
    
    <!-- Registration Form -->
    <form id="register-form" class="Register" action="/register" method="POST">
      <h3>Create an Account</h3>
      
      <!-- Placed error banner neatly right above the inputs -->
      <% if(locals.error) { %>
        <div class="error-banner"><%= error %></div>
      <% } %>
      
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" placeholder="Enter your username" required>
      </div>
      <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="Enter your Email" required>
      </div>
      <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="Enter your password" required>
      </div>
      <button type="submit">Register</button>
      <p class="toggle-link">Already have an account? <a onclick="toggleForms()">Sign In</a></p>
    </form>

    <!-- Login Form -->
    <form id="login-form" class="Login hidden" action="/login" method="POST">
        <h3>Welcome Back!</h3>
      
        <div class="form-group">
            <label for="login-email">Email</label>
            <input type="email" id="login-email" name="email" placeholder="Enter your Email" required>
        </div>
        <div class="form-group">
            <label for="login-password">Password</label>
            <input type="password" id="login-password" name="password" placeholder="Enter your password" required>
        </div>
        <button type="submit">Sign In</button>
        <p class="toggle-link">Don't have an account? <a onclick="toggleForms()">Create one</a></p>
    </form>
  </div>

  <script>
      function toggleForms() {
          const registerForm = document.getElementById('register-form');
          const loginForm = document.getElementById('login-form');

          registerForm.classList.toggle('hidden');
          loginForm.classList.toggle('hidden');
      }
  </script>
</body>
</html>