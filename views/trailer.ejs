<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to GenZ Talk! ✨</title>
    <!-- Friendly bold Google font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&display=swap" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            /* ☁️ Cloud Blue base mixed with friendly Lavender & soft Pink aura spots */
            background-color: #e3edff;
            background-image: 
                radial-gradient(at 0% 0%, #e0c3fc 0px, transparent 50%),
                radial-gradient(at 100% 100%, #ffdfd3 0px, transparent 50%),
                radial-gradient(at 50% 50%, #e3edff 0px, transparent 100%);
            
            color: #2b3a4a;
            font-family: 'Fredoka', system-ui, sans-serif;
            overflow: hidden;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .trailer-container {
            text-align: center;
            width: 90%;
            max-width: 500px;
            position: relative;
        }

        /* Animated Intro Typography */
        .trailer-text {
            font-size: clamp(1.8rem, 6vw, 2.8rem);
            font-weight: 700;
            color: #3b4d61;
            opacity: 0;
            position: absolute;
            width: 100%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            animation: cloudBounce 3.5s ease-in-out forwards;
            line-height: 1.3;
        }

        .emoji-pop {
            display: block;
            font-size: 3.5rem;
            margin-bottom: 12px;
            animation: dynamicFloat 2s ease-in-out infinite alternate;
        }

        /* Timing delays for text steps */
        .slide-1 { animation-delay: 0.5s; }
        .slide-2 { animation-delay: 4s; }
        .slide-3 { animation-delay: 7.5s; }

        /* The final friendly community card layout */
        .welcome-card {
            opacity: 0;
            animation: cardReveal 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 11s forwards;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(20px);
            border-radius: 32px;
            padding: 40px 30px;
            box-shadow: 0 20px 50px rgba(138, 164, 203, 0.25);
            border: 2px solid rgba(255, 255, 255, 0.6);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
            transform: scale(0.8) translateY(30px);
        }

        .welcome-card h1 {
            font-size: clamp(1.8rem, 5vw, 2.4rem);
            color: #1e293b;
        }

        /* Bold aesthetic tag for the database username */
        .username-tag {
            background: #4a90e2;
            color: #ffffff;
            padding: 4px 18px;
            border-radius: 16px;
            display: inline-block;
            box-shadow: 0 5px 15px rgba(74, 144, 226, 0.2);
        }

        /* Friendly pill-shaped skip button */
        .launch-btn {
            background: #1e293b;
            color: #ffffff;
            border: none;
            padding: 16px 44px;
            font-size: 1.15rem;
            font-weight: 700;
            border-radius: 100px;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(30, 41, 59, 0.25);
            transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            text-decoration: none;
            margin-top: 10px;
        }

        .launch-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(30, 41, 59, 0.35);
            background: #4a90e2;
        }

        /* Soft floating & bouncing animations */
        @keyframes cloudBounce {
            0% { opacity: 0; transform: translate(-50%, -30%) scale(0.9); filter: blur(5px); }
            12% { opacity: 1; transform: translate(-50%, -50%) scale(1.02); filter: blur(0px); }
            16% { transform: translate(-50%, -50%) scale(1); }
            85% { opacity: 1; transform: translate(-50%, -50%) scale(1); filter: blur(0px); }
            100% { opacity: 0; transform: translate(-50%, -70%) scale(0.95); filter: blur(5px); }
        }

        @keyframes cardReveal {
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        @keyframes dynamicFloat {
            0% { transform: translateY(0px); }
            100% { transform: translateY(-8px); }
        }
    </style>
</head>
<body>

    <div class="trailer-container">
        <!-- Slide 1: Soft open -->
        <div class="trailer-text slide-1">
            <span class="emoji-pop">☁️</span>
            Looking for a cleaner place to hang out?
        </div>

        <!-- Slide 2: Core Purpose definition -->
        <div class="trailer-text slide-2">
            <span class="emoji-pop">⚡</span>
            We created a simple space built entirely around real conversations.
        </div>

        <!-- Slide 3: Brand announcement -->
        <div class="trailer-text slide-3">
            <span class="emoji-pop">🎈</span>
            Welcome <%=user.username%> <br>This is GenZ Talk.
        </div>

        <!-- Final Landing Card -->
        <div class="welcome-card">
            <span style="font-size: 3rem; display: inline-block; animation: dynamicFloat 1.5s infinite alternate;">🥳</span>
            <h1>Account ready, <br>
                <span class="username-tag"><%= locals.name ? name : 'Friend' %></span>!
            </h1>
            <p style="color: #64748b; font-size: 0.95rem;">Jump right in and meet the group and please read the policy of our community</p>
            <a href="/home" class="launch-btn">Enter App ✨</a>
        </div>
    </div>

</body>
</html>